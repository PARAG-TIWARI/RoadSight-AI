# ================================================================
# RoadSight AI — Environment Configuration Template
# Copy this file to .env in your root and backend/frontend directories
# ================================================================

# --- Backend Model Configuration ---
# Format: 'onnx' (recommended for production/CPU) or 'pytorch'
MODEL_FORMAT=onnx
MODEL_PATH=best.onnx
INPUT_SIZE=640

# --- Inference Thresholds ---
CONFIDENCE_THRESHOLD=0.40
NMS_IOU_THRESHOLD=0.50

# --- Event Processing & Defect Tracking ---
MIN_AREA_RATIO=0.005
MIN_AREA_PIXELS=300
PERSISTENCE_FRAMES=3
HIGH_CONFIDENCE_THRESHOLD=0.75
LARGE_AREA_RATIO=0.05

# --- Video Analytics Bounds ---
MAX_VIDEO_FRAMES=500
VIDEO_SKIP_FRAMES=1

# --- Server & Security ---
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_VERSION=1.0.0
APP_NAME=RoadSight AI API

# --- Frontend Environment Variables ---
VITE_API_BASE_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
